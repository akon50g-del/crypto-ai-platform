# ===== Crypto AI Signals Platform — production env (docker compose) =====
# Copy to .env and fill. Empty optional keys = feature stays dormant (honest 503/dry-run).

# Database
POSTGRES_USER=crypto
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=crypto_ai

# API
JWT_SECRET=change-me-long-random-string
AI_ENGINE_INTERNAL_TOKEN=change-me-internal-token
FRONTEND_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Stripe (optional — payments activate when set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_VIP=

# Notifications (optional — dry-run when empty)
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=signals@example.com

# Public URLs baked into the web build
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Market data (Binance public mirror; switch to https://api.binance.com if reachable)
BINANCE_BASE_URL=https://data-api.binance.vision
