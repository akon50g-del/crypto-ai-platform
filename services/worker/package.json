{
  "name": "worker",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "job:news": "ts-node src/cli.ts news",
    "job:calendar": "ts-node src/cli.ts calendar",
    "job:notify": "ts-node src/cli.ts notify",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.4.0",
    "nodemailer": "^6.9.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["src"],
    "testMatch": ["**/*.spec.ts"]
  }
}
